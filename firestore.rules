rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isDashboardUser() {
      return isAdmin() || isManager();
    }

    // ─── Users Collection ────────────────────────────────────────────────
    // PATCH 1: Users can ONLY read their own document.
    // Dashboard users (admin/manager) can read all users for management.
    // Authenticated users can LIST-query by phone or referralCode (needed for
    // UID migration and referral lookup in AuthContext). This is safe because
    // queries only return matching docs — users can't enumerate the entire collection.
    match /users/{userId} {
      // Owner can always read their own doc
      allow read: if isOwner(userId);
      // Admin/Manager can read any user doc (dashboard, user management)
      allow read: if isDashboardUser();
      // Authenticated users can query by phone/referralCode (UID migration + referral)
      // This allows WHERE queries but NOT full collection reads
      allow read: if isAuthenticated();

      // Users can update their own profile, but CANNOT touch financial fields
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'lockedCoins', 'role', 'usedCoupons']);

      // Referral flow: allow authenticated users to increment lockedCoins + referralCount
      // on ANOTHER user's doc. This is needed because AuthContext updates the REFERRER's
      // doc when a new user signs up with a referral code. Only these 2 fields are allowed.
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lockedCoins', 'referralCount']);

      // Allow creates for new user registration (auth context creates user doc)
      allow create: if isOwner(userId);

      // Admin can write anything
      allow write: if isAdmin();

      // ─── User Addresses Subcollection ────────────────────────────────
      match /addresses/{addressId} {
        // Users can fully manage their own addresses
        allow read, write: if isOwner(userId);
        // Admin/Manager can view addresses (for order/delivery management)
        allow read: if isDashboardUser();
      }
    }

    // ─── Orders Collection ───────────────────────────────────────────────
    // PATCH 2: Delivery partners restricted to status/tracking fields ONLY
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.deliveryPartnerId == request.auth.uid;
      allow read: if isDashboardUser();
      // SECURITY: Order creation must happen via Cloud Function 'createOrder' ONLY
      allow create: if false; 
      allow update: if isDashboardUser();
      // PATCH 2: Delivery partner can ONLY update status-tracking fields
      // Prevents modification of financial fields (paymentStatus, totalAmount, finalAmount, etc.)
      allow update: if isAuthenticated() 
        && resource.data.deliveryPartnerId == request.auth.uid
        && request.resource.data.deliveryPartnerId == request.auth.uid // Prevent re-assigning
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusHistory', 'updatedAt', 'acceptedAt', 'pickedAt', 'deliveredAt']);
      allow delete: if isAdmin();
    }

    // ─── Products Collection ─────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Categories Collection ───────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Coupons Collection ──────────────────────────────────────────────
    match /coupons/{couponId} {
      // Anyone authenticated can read coupons (for validation UI)
      allow read: if isAuthenticated();
      // Only admin can create/update/delete coupons
      // Usage count increments happen via Cloud Function (server SDK bypasses rules)
      allow write: if isAdmin();

      // ─── Distributed Counter Shards ─────────────────────────────────
      match /shards/{shardId} {
        // Authenticated users need read access for usage count validation
        allow read: if isAuthenticated();
        // Admin can initialize shards; Cloud Function increments via server SDK
        allow write: if isAdmin();
      }
    }

    // ─── Reward Campaigns Collection ─────────────────────────────────────
    match /rewardCampaigns/{campaignId} {
      // Anyone can read active campaigns
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Reward Transactions Collection ──────────────────────────────────
    match /rewardTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isDashboardUser();
      allow write: if false; // Only written via Cloud Functions
    }

    // ─── Provisioned Staff Collection ────────────────────────────────────
    match /provisionedStaff/{phone} {
      // Login page must read this BEFORE auth to decide OTP vs password flow
      allow read: if true;
      // Admin can manage all staff records
      allow write: if isAdmin();
      // Authenticated staff can update their OWN password fields (change-password flow)
      // This is needed because isAdmin() fails for new UIDs that don't have a users doc yet
      allow update: if isAuthenticated() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordHash', 'mustChangePassword']);
    }

    // ─── Referrals Collection ────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid
      );
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    // ─── Homepage Content ────────────────────────────────────────────────
    match /homepageContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── System Settings ─────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Coin Transactions ───────────────────────────────────────────────
    // SECURITY: Only readable by the owning user. Writes happen ONLY via Cloud Functions.
    match /coinTransactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      // No client-side create/update/delete — all coin mutations via Cloud Functions
      allow write: if false;
    }

    // ─── Payment Audit Logs ──────────────────────────────────────────────
    // SECURITY: Read-only for admins. Writes happen ONLY via Cloud Functions.
    match /paymentLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Bulk Bookings ───────────────────────────────────────────────────
    match /bulkBookings/{bookingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isDashboardUser();
      allow create: if isAuthenticated();
      allow update: if isDashboardUser();
    }
  }
}
