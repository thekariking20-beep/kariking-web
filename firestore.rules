rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isDashboardUser() {
      return isAdmin() || isManager();
    }

    // ─── Users Collection ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow read: if isDashboardUser();
      // Allow authenticated users to query by phone (needed for UID migration in AuthContext)
      allow read: if isAuthenticated();

      // Users can update their own profile, but CANNOT touch financial fields
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'lockedCoins', 'role', 'usedCoupons']);

      // Allow creates for new user registration (auth context creates user doc)
      allow create: if isOwner(userId);

      // Admin can write anything
      allow write: if isAdmin();
    }

    // ─── Orders Collection ───────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.deliveryPartnerId == request.auth.uid;
      allow read: if isDashboardUser();
      // SECURITY: Order creation must happen via Cloud Function 'createOrder' ONLY
      allow create: if false; 
      allow update: if isDashboardUser();
      allow update: if isAuthenticated() && resource.data.deliveryPartnerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Products Collection ─────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Categories Collection ───────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Coupons Collection ──────────────────────────────────────────────
    match /coupons/{couponId} {
      // Anyone authenticated can read coupons (for validation UI)
      allow read: if isAuthenticated();
      // Only admin can create/update/delete coupons
      // Usage count increments happen via Cloud Function transaction
      allow write: if isAdmin();
    }

    // ─── Provisioned Staff Collection ────────────────────────────────────
    match /provisionedStaff/{phone} {
      // Login page must read this BEFORE auth to decide OTP vs password flow
      allow read: if true;
      // Admin can manage all staff records
      allow write: if isAdmin();
      // Authenticated staff can update their OWN password fields (change-password flow)
      // This is needed because isAdmin() fails for new UIDs that don't have a users doc yet
      allow update: if isAuthenticated() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordHash', 'mustChangePassword']);
    }

    // ─── Referrals Collection ────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid
      );
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    // ─── Homepage Content ────────────────────────────────────────────────
    match /homepageContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── System Settings ─────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Coin Transactions ───────────────────────────────────────────────
    // SECURITY: Only readable by the owning user. Creates happen ONLY via Cloud Functions.
    match /coinTransactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      // No client-side create/update/delete — all coin mutations via Cloud Functions
      allow write: if false;
    }

    // ─── Payment Audit Logs ──────────────────────────────────────────────
    // SECURITY: Read-only for admins. Writes happen ONLY via Cloud Functions.
    match /paymentLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Bulk Bookings ───────────────────────────────────────────────────
    match /bulkBookings/{bookingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isDashboardUser();
      allow create: if isAuthenticated();
      allow update: if isDashboardUser();
    }
  }
}
